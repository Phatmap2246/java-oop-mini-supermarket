# ==================================================
# CẤU HÌNH GITIGNORE CHO DỰ ÁN JAVA OOP - SIÊU THỊ MINI
# ==================================================

# 1. Các file biên dịch của Java (Bytecode)
*.class

# 2. Thư mục chứa file build / output
bin/
out/
build/
target/

# 3. File cấu hình của các IDE/Editor
# Chặn toàn bộ thư mục .vscode...
.vscode/
# ...NHƯNG CHO PHÉP đẩy file cấu hình này lên (chứa classpath của thư viện ZXing)
!.vscode/settings.json

# IntelliJ IDEA
.idea/
*.iml
*.iws
# Eclipse
.project
.classpath
.settings/

# 4. File của các công cụ Build (Gradle, Maven)
.gradle/
gradlew
gradlew.bat

# 5. File hệ điều hành (OS)
.DS_Store
._*             <-- Thêm dòng này để chặn file rác của Mac
Thumbs.db
ehthumbs.db
Desktop.ini

# 6. Dữ liệu sinh ra khi chạy chương trình (Runtime data)
hoadon.txt
QR/            
*.log